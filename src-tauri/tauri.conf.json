{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drive Cloud",
  "version": "0.1.0",
  "identifier": "br.com.drivecloud.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Drive Cloud",
        "label": "main",
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 580,
        "backgroundColor": "#151517"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
